# WireSploit runs without any API keys. Copy this file to .env only if you want
# optional authenticated enrichment providers. Keep .env private and never commit it.
# Environment variables already set in Windows take precedence over values here.

# Search existing urlscan.io scans only (no scan submissions)
URLSCAN_API_KEY=

# Reputation / threat-context lookups
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# Shodan Internet DB (no key required for basic lookups)
# SHODAN_API_KEY=

# Censys (requires API ID and Secret)
# CENSYS_API_ID=
# CENSYS_API_SECRET=

# =============================================================================
# Kali Linux Environment Configuration
# =============================================================================
# Detected automatically by setup_wizard.py. Set manually if needed.
# KALI_ENV_TYPE=native|wsl2|ssh
# KALI_WSL_DISTRO=kali-linux
# KALI_SSH_HOST=192.168.1.100
# KALI_SSH_USER=kali
# KALI_SSH_KEY=/path/to/private/key

# =============================================================================
# Server Configuration
# =============================================================================
# HOST=127.0.0.1
# PORT=8765

# =============================================================================
# Feature Flags
# =============================================================================
# ENABLE_AI=false
# LOG_LEVEL=INFO