class Spec:
    def __init__(
        self,
        id: str,
        name: str,
        kind: str,
        categories: List[str],
        automated: bool = True,
        authorized_only: bool = False,
        deep_only: bool = False,
        url: str = "",
    ):
        self.id = id
        self.name = name
        self.kind = kind
        self.categories = categories
        self.automated = automated
        self.authorized_only = authorized_only
        self.deep_only = deep_only
        self.url = url

